# 大模型配置（支持本地 LM Studio / vLLM / Ollama 或 OpenAI 兼容端点）
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=your-openai-or-local-key
MODEL_NAME=google/gemma-4-e4b

# 外部搜索服务配置 (Tavily)
TAVILY_API_KEY=tvly-your-tavily-api-key

# 工作流与服务配置
MAX_RETRY_COUNT=2
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
